import random

states = ["D", "C"]          # D=Dirty, C=Clean
actions = ["L", "R"]         # L=Low energy, R=Regular cleaning
Q = {(s,a): 0 for s in states for a in actions}

for _ in range(1000):
    s, G = "D", 0
    for t in range(10):
        a = max(actions, key=lambda x: Q[s,x]) if random.random() > .1 else random.choice(actions)
        r = 10 if s=="D" else -1
        if a=="L": r -= 1          # energy saving
        G += r
        Q[s,a] += .1 * (G-Q[s,a])
        s = "C" if s=="D" else "D"

for s in states:
    print(s, max(actions, key=lambda a: Q[s,a]), Q[s, max(actions,key=lambda a:Q[s,a])])
